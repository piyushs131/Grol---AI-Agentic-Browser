+void ComponentLoader::AddGrolAgentExtension() {
+  base::FilePath dir;
+  const base::CommandLine* command_line =
+      base::CommandLine::ForCurrentProcess();
+  if (command_line->HasSwitch("grol-agent-dir")) {
+    dir = command_line->GetSwitchValuePath("grol-agent-dir");
+  } else {
+    CHECK(base::PathService::Get(chrome::DIR_RESOURCES, &dir));
+    dir = dir.Append(FILE_PATH_LITERAL("grol_agent"));
+  }
+  // The manifest is read from disk (it carries a stable "key"): a few KB of
+  // blocking IO on the UI thread, once, during startup.
+  base::ScopedAllowBlockingForTesting allow_blocking;
+  dir = base::MakeAbsoluteFilePath(dir);
+  std::string error;
+  std::optional<base::DictValue> manifest =
+      file_util::LoadManifest(dir, &error);
+  if (!manifest) {
+    LOG(ERROR) << "Grol agent not loaded from " << dir << ": " << error;
+    return;
+  }
+  Add(std::move(*manifest), dir, /*skip_allowlist=*/true);
+}
