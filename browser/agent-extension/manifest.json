{
  "manifest_version": 3,
  "name": "Grol Agent",
  "version": "0.1.2",
  "description": "Drives pages for the Grol agent over the DevTools protocol.",
  "minimum_chrome_version": "120",
  "permissions": [
    "debugger",
    "tabs",
    "scripting",
    "activeTab",
    "storage",
    "sidePanel",
    "declarativeNetRequest",
    "alarms",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1/*",
    "ws://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "key": "",
  "icons": {
    "16": "icons/grol-16.png",
    "32": "icons/grol-32.png",
    "48": "icons/grol-48.png",
    "128": "icons/grol-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.youtube-nocookie.com/*"
      ],
      "js": [
        "adblock/youtube-main.js"
      ],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.youtube-nocookie.com/*"
      ],
      "js": [
        "adblock/youtube.js"
      ],
      "css": [
        "adblock/youtube.css"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "css": [
        "adblock/cosmetic.css",
        "adblock/lists/generic.css"
      ],
      "exclude_matches": [
        "*://*.accounts.google.com/*",
        "*://*.adblockplus.org/*",
        "*://*.ads.microsoft.com/*",
        "*://*.adsmanager.facebook.com/*",
        "*://*.aetv.com/*",
        "*://*.amazon.ae/*",
        "*://*.amazon.ca/*",
