{
  "manifest_version": 3,
  "name": "Grol Agent",
  "version": "0.1.0",
  "description": "Drives pages for the Grol agent over the DevTools protocol.",
  "minimum_chrome_version": "120",
  "permissions": [
    "debugger",
    "tabs",
    "scripting",
    "activeTab",
    "storage",
    "sidePanel"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1/*",
    "ws://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Grol Agent",
    "default_icon": {
      "16": "icons/grol-16.png",
      "32": "icons/grol-32.png"
    }
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "key": "",
  "icons": {
    "16": "icons/grol-16.png",
    "32": "icons/grol-32.png",
    "48": "icons/grol-48.png",
    "128": "icons/grol-128.png"
  }
}
