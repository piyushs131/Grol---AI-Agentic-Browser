    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "adblock/cosmetic-request.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "*://www.google.com/search*",
        "*://www.google.co.in/search*",
        "*://www.google.co.uk/search*",
